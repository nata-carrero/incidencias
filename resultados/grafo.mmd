config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	orquestador(orquestador)
	evidencia(evidencia)
	diagnostico(diagnostico)
	verificar_anclaje(verificar_anclaje)
	guardar(guardar)
	revision_humana(revision_humana)
	cargar(cargar)
	__end__([<p>__end__</p>]):::last
	__start__ --> orquestador;
	diagnostico --> verificar_anclaje;
	evidencia --> diagnostico;
	guardar --> orquestador;
	orquestador -.-> evidencia;
	orquestador -.-> revision_humana;
	revision_humana --> cargar;
	verificar_anclaje -.-> diagnostico;
	verificar_anclaje -.-> guardar;
	cargar --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
